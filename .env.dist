APP_NAME=gusteau
APP_ENV=prod

GRPC_PORT=50051
HTTP_GATEWAY=gateway:9090
WEBSOCKET_STREAMING=streaming:8080

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/gusteau
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/gusteau

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=gusteau-client
MESSAGE_CONSUMER_TOPIC_GUSTEAU_CONNECTING_REQUEST=gusteau.connecting-request
PG_BOSS_WEBSOCKET_SEND_EVENT=pg-boss.websocket-send-event

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=gusteau-pg-boss

DEVICE_ID=gusteau-device-id

ACCESS_SECRET=your_access_secret
